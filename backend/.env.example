# Copy to .env for local development. Generate JWT_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
JWT_SECRET_KEY=replace-with-output-from-secrets-token-url-safe
DATABASE_URL=sqlite:///./ableconnect.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=false
AUTO_CREATE_SCHEMA=false
CERTIFICATES_STORAGE_DIR=./storage/certificates
